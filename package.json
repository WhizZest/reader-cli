{
  "name": "reader-cli",
  "version": "1.0.0",
  "description": "CLI tools for online reading platforms",
  "type": "module",
  "main": "dist/main.js",
  "bin": {
    "reader-cli": "./dist/main.js"
  },
  "scripts": {
    "build": "npm run clean-dist && tsc && npm run copy-assets",
    "clean-dist": "node -e \"const fs=require('fs'); const path='dist'; if(fs.existsSync(path)){fs.rmSync(path,{recursive:true})}\"",
    "copy-assets": "node scripts/copy-assets.js",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cli",
    "reading",
    "books",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^11.0.0",
    "ora": "^7.0.0",
    "puppeteer": "^21.0.0",
    "turndown": "^7.0.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.0",
    "@types/node": "^20.0.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.5.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
